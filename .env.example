# Environment variables for Insurance Claims Fraud Detection API

# Deployment environment (development or production)
ENV=production

# Port for the API server
PORT=8000

# CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=*

# Model file path (leave blank to use default: models/churn_model.pkl)
# MODEL_PATH=models/churn_model.pkl

# Claims database path (leave blank to use default: data/insurance_claims.csv)
# CLAIMS_DB_PATH=data/insurance_claims.csv
